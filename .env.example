# Environment (dev | qa | staging)
ENV=qa

# SauceDemo credentials (UI tests)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# API base URL (JSONPlaceholder)
API_BASE_URL=https://jsonplaceholder.typicode.com

# API auth token placeholder (replace with a real token when needed)
API_TOKEN=your-api-token-here

# Browser settings
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# Parallelism
WORKERS=2

# Retry settings
RERUNS=2
RERUNS_DELAY=1

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
